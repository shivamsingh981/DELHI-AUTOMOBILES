rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A photo must be a small JPEG data URL (the website shrinks photos before sending).
    function okImg(s) {
      return s is string && s.size() <= 250000 && s.matches('^data:image/jpeg;base64,.*');
    }

    // Skyvibe Travels reviews: anyone can read and add.
    // Nobody can edit or delete from the website (do that in the Firebase console).
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['name', 'trip', 'rating', 'text', 'images', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
        && request.resource.data.trip is string
        && request.resource.data.trip.size() <= 80
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 500
        && request.resource.data.images is list
        && request.resource.data.images.size() <= 3
        && (request.resource.data.images.size() < 1 || okImg(request.resource.data.images[0]))
        && (request.resource.data.images.size() < 2 || okImg(request.resource.data.images[1]))
        && (request.resource.data.images.size() < 3 || okImg(request.resource.data.images[2]))
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // Delhi Automobiles reviews: anyone can read and add.
    // Nobody can edit or delete from the website (do that in the Firebase console).
    match /delhi_reviews/{reviewId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['name', 'car', 'rating', 'text', 'images', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
        && request.resource.data.car is string
        && request.resource.data.car.size() <= 80
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 500
        && request.resource.data.images is list
        && request.resource.data.images.size() <= 3
        && (request.resource.data.images.size() < 1 || okImg(request.resource.data.images[0]))
        && (request.resource.data.images.size() < 2 || okImg(request.resource.data.images[1]))
        && (request.resource.data.images.size() < 3 || okImg(request.resource.data.images[2]))
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
